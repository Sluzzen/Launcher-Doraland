  "ui": {
    "discordUrl": "",
    "websiteUrl": "",
    "youtubeUrl": "",
    "backgroundVideoUrl": ""
  },
  "launcher": {
    "version": "1.0.0",
    "allowPremium": true,
    "allowOffline": true,
    "gameDataFolder": ".doraland",
    "closeOnLaunch": false
